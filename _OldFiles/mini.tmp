class MiniModeWindow(QWidget):
    def __init__(self, parent_main: QWidget, windows: list[dict]):
        super().__init__(parent_main)
        self.main = parent_main
        self.windows = list(windows)
        self._handles_set = {w.get('handle') for w in self.windows if w.get('handle') and w.get('enabled')}

        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Tool)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setObjectName('MiniModeWindow')
        self.setStyleSheet('#miniContainer { background: rgba(19,20,22,0.86); border-radius:24px; } QLabel, QPushButton { border:none; color:white;} QPushButton{ background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.15); border-radius:8px; padding:4px 8px;} QPushButton:hover{ background:rgba(255,255,255,0.18);} ')
        self.setFixedHeight(96)

        root = QHBoxLayout(self); root.setContentsMargins(8,8,8,8); root.setSpacing(0)
        container = QWidget(objectName='miniContainer')
        h = QHBoxLayout(container); h.setContentsMargins(12,8,12,8); h.setSpacing(8)

        self.btn_exit = QPushButton('⤢')
        self.btn_exit.setFixedSize(28, 28)
        self.btn_exit.setToolTip('Revenir au mode normal')
        self.btn_exit.clicked.connect(self._exit_to_main)
        h.addWidget(self.btn_exit)

        self.drag = QLabel('↗'); self.drag.setStyleSheet('font-size:16px; color:rgba(255,255,255,0.8);'); self.drag.setCursor(Qt.OpenHandCursor)
        h.addWidget(self.drag)

        self.btn_refresh = QPushButton('↻')
        self.btn_refresh.setFixedSize(28, 28)
        self.btn_refresh.setToolTip('Actualiser l\'ordre (barre des tâches)')
        self.btn_refresh.clicked.connect(self._apply_taskbar_order)
        h.addWidget(self.btn_refresh)

        self.list = QListWidget()
        self.list.setFlow(QListWidget.LeftToRight)
        self.list.setWrapping(False)
        self.list.setSpacing(8)
        self.list.setFixedHeight(72)
        self.list.setDragDropMode(QAbstractItemView.InternalMove)
        self.list.itemDoubleClicked.connect(self._on_double_click)
        self.list.model().rowsMoved.connect(self._sync_back_to_main_from_mini)
        self.list.setContextMenuPolicy(Qt.CustomContextMenu)
        self.list.customContextMenuRequested.connect(self._open_context_menu)
        h.addWidget(self.list, 1)

        right = QVBoxLayout()
        lab = QLabel('Raccourci suivant')
        lab.setStyleSheet('font-size:11px; color:rgba(255,255,255,0.7);')
        self.key_label = QLabel(getattr(self.main, 'hotkey_next', ''))
        self.key_label.setStyleSheet('background:#E6E6E6; color:#111; border-radius:6px; padding:6px 10px; font-weight:600;')
        right.addWidget(lab)
        key_row = QHBoxLayout()
        self.key_label = QLabel(getattr(self.main, 'hotkey_next', ''))
        self.key_label.setStyleSheet('background:#E6E6E6; color:#111; border-radius:6px; padding:6px 10px; font-weight:600;')
        self.btn_change_key = QPushButton('Changer…')
        self.btn_change_key.setFixedHeight(28)
        self.btn_change_key.clicked.connect(self._change_next_hotkey)
        key_row.addWidget(self.key_label)
        key_row.addWidget(self.btn_change_key)
        right.addLayout(key_row)
        right.addStretch()
        h.addLayout(right)

        root.addWidget(container)
        self._populate()

        self._drag_pos: QPoint | None = None
        self.drag.installEventFilter(self)

        self._timer = QTimer(self); self._timer.setInterval(400)
        self._timer.timeout.connect(self._update_topmost_state)
        self._timer.start()
        self._update_topmost_state()

    def set_next_hotkey_label(self, txt: str): self.key_label.setText(txt)

    def eventFilter(self, obj, event):
        if obj is self.drag:
            et = event.type()
            if et == QtCore.QEvent.MouseButtonPress and event.button() == Qt.LeftButton:
                self._drag_pos = event.globalPos() - self.frameGeometry().topLeft(); self.drag.setCursor(Qt.ClosedHandCursor); return True
            elif et == QtCore.QEvent.MouseMove and self._drag_pos is not None and (event.buttons() & Qt.LeftButton):
                self.move(event.globalPos() - self._drag_pos); return True
            elif et == QtCore.QEvent.MouseButtonRelease:
                self._drag_pos = None; self.drag.setCursor(Qt.OpenHandCursor); return True
        return super().eventFilter(obj, event)

    
        self._auto_resize()

    def _current_handles_order(self):
        order = []
        for i in range(self.list.count()):
            data = self.list.item(i).data(Qt.UserRole) or {}; h = data.get('handle')
            if h: order.append(h)
        return order

    def _sync_back_to_main_from_mini(self):
        ordered = []
        for i in range(self.list.count()):
            it = self.list.item(i); data = it.data(Qt.UserRole) or {}; wid = self.list.itemWidget(it)
            if wid: data['enabled'] = bool(wid.chk.isChecked())
            ordered.append(data)
        self.windows = ordered; self._handles_set = { w.get('handle') for w in self.windows if w.get('handle') and w.get('enabled') }
        try: self.main.reorder_main_list_by_handles(self._current_handles_order())
        except Exception: pass

    def _on_toggle_enabled(self, handle: int, enabled: bool):
        try: self.main.set_focus_enabled_for_handle(handle, enabled)
        except Exception: pass
        if enabled: self._handles_set.add(handle)
        else: self._handles_set.discard(handle)

    def _on_double_click(self, item: QListWidgetItem):
        data = item.data(Qt.UserRole) or {}; hwnd = data.get('handle')
        if hwnd:
            try:
                if win32gui.IsIconic(hwnd): win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
                else: win32gui.ShowWindow(hwnd, win32con.SW_SHOW)
                time.sleep(0.02); win32gui.SetForegroundWindow(hwnd)
            except Exception: pass

    def _open_context_menu(self, pos):
        it = self.list.itemAt(pos)
        if not it: return
        data = it.data(Qt.UserRole) or {}; hwnd = data.get('handle'); pseudo = data.get('pseudo','')
        menu = QMenu(self); act_define = menu.addAction('Définir un raccourci…'); act_focus = menu.addAction('Mettre le focus')
        chosen = menu.exec(self.list.mapToGlobal(pos))
        if chosen == act_define and hwnd:
            try: self.main.define_hotkey_for_handle_from_mini(hwnd, pseudo)
            except Exception: pass
        elif chosen == act_focus and hwnd:
            try:
                if win32gui.IsIconic(hwnd): win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)
                else: win32gui.ShowWindow(hwnd, win32con.SW_SHOW)
                time.sleep(0.02); win32gui.SetForegroundWindow(hwnd)
            except Exception: pass

    def _update_topmost_state(self):
        try: fg = win32gui.GetForegroundWindow()
        except Exception: fg = None
        root = None
        try:
            if fg: root = win32gui.GetAncestor(fg, win32con.GA_ROOT)
        except Exception: root = fg
        should_top = root in self._handles_set
        flags = self.windowFlags(); changed = False
        if should_top:
            if not (flags & Qt.WindowStaysOnTopHint): self.setWindowFlag(Qt.WindowStaysOnTopHint, True); changed = True
            if changed or not self.isVisible(): self.show();
        else:
            if (flags & Qt.WindowStaysOnTopHint): self.setWindowFlag(Qt.WindowStaysOnTopHint, False); changed = True
            if self.isVisible(): self.hide()
    def _apply_taskbar_order(self):
        handles = self._current_handles_order()
        try:
            self.main.apply_taskbar_order(handles)
        except Exception:
            pass

    def _auto_resize(self):
        try:
            count = self.list.count()
            if count <= 0:
                return
            item_w = 92
            spacing = 8
            left_controls = 28 + 8 + 28 + 8 + 28  # exit + space + drag ~label width + space + refresh
            right_w = 220
            paddings = 40
            width = left_controls + (count * (item_w + spacing)) - spacing + right_w + paddings
            width = max(width, 520)
            self.resize(width, self.height())
        except Exception:
            pass
