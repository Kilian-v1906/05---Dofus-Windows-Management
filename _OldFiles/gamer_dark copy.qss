/* ===== Gamer Dark (no variables, valid selectors) ===== */

/* App */
QWidget {
    background: #0E0F12;
    color: #F5F7FA;
    font-family: "Segoe UI","Inter","Roboto","Cantarell";
    font-size: 13px;
}

/* Muted labels via dynamic property: setProperty("muted", true) */
QLabel[muted="true"] { color: rgba(255,255,255,0.65); }

/* Header controls */
QComboBox {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 10px;
    padding: 6px 10px;
}
QComboBox:hover { background: rgba(255,255,255,0.10); }
QComboBox::drop-down { width: 26px; border: none; }

QPushButton {
    background: rgba(255,255,255,0.06);
    color: #F5F7FA;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px;
    padding: 8px 14px;
}
QPushButton:hover { background: rgba(255,255,255,0.10); }
QPushButton:pressed { background: rgba(255,255,255,0.16); }

/* Pill labels via dynamic property: setProperty("pill", true) */
QLabel[pill="true"] {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
    padding: 6px 12px;
    font-weight: 600;
}

/* List cards */
QFrame#card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;
}
QFrame#card:hover {
    background: rgba(255,255,255,0.10);
    border-color: rgba(0,229,255,0.22);
}

/* Index badge via objectName */
QLabel#indexBadge {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px;
    padding: 4px 8px;
    color: rgba(255,255,255,0.70);
}

/* Toggle (QCheckBox) as rounded switch */
QCheckBox::indicator { width: 42px; height: 22px; }
QCheckBox::indicator:unchecked {
    border-radius: 11px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 rgba(255,255,255,0.08),
                                stop:1 rgba(255,255,255,0.03));
    border: 1px solid rgba(255,255,255,0.18);
}
QCheckBox::indicator:unchecked:hover { background: rgba(255,255,255,0.12); }
QCheckBox::indicator:checked {
    border-radius: 11px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                                stop:0 rgba(0,208,132,0.85),
                                stop:1 rgba(0,229,255,0.85));
    border: 1px solid rgba(0,229,255,0.55);
}

/* ListView */
QListWidget { border: none; background: transparent; }

/* Scrollbar minimal */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 8px 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.18); border-radius: 6px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.32);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; border: none; }

/* Status bar */
QLabel#statusBar { color: rgba(255,255,255,0.65); }

/* Bottom neon buttons via dynamic property: setProperty("neon","primary|success") */
QPushButton[neon="primary"] {
    background: rgba(0,229,255,0.10);
    border: 1px solid rgba(0,229,255,0.35);
}
QPushButton[neon="primary"]:hover {
    background: rgba(0,229,255,0.16);
    border-color: rgba(0,229,255,0.55);
}
QPushButton[neon="success"] {
    background: rgba(0,208,132,0.10);
    border: 1px solid rgba(0,208,132,0.35);
}
QPushButton[neon="success"]:hover {
    background: rgba(0,208,132,0.16);
    border-color: rgba(0,208,132,0.55);
}

/* Tous les sous-éléments d'une carte n'ont pas de fond ni de bordure,
   sauf ceux qui ont des styles plus spécifiques (indexBadge, [pill="true"], etc.) */
QFrame#card QLabel,
QFrame#card QPushButton,
QFrame#card QWidget {
    background: transparent;
    border: none;
    color: #F5F7FA;
}

/* On laisse les exceptions suivantes s'appliquer plus bas :
   - QLabel#indexBadge
   - QLabel[pill="true"]
   - QCheckBox::indicator (switch)
*/

/* Badge du hotkey (visuellement distinct d’un bouton) */
QLabel#hotkeyBadge {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 6px;       /* beaucoup moins arrondi qu'un bouton */
    padding: 6px 10px;
    font-weight: 600;
    color: #F5F7FA;
}

QPushButton#settingsIcon {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;      /* rond (36x36) */
    padding: 6px;
}
QPushButton#settingsIcon:hover {
    background: rgba(255,255,255,0.10);
    border-color: rgba(0,229,255,0.35);
}

/* Panneaux de la fenêtre "Gestion des profils" */
QFrame#panelCard {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 14px;
    padding: 10px;
}
QFrame#panelCard:hover {
    background: rgba(255,255,255,0.09);
}

/* Lignes internes d’un panneau: transparence par défaut */
QFrame#panelCard QLabel,
QFrame#panelCard QPushButton,
QFrame#panelCard QWidget {
    background: transparent;
    border: none;
    color: #F5F7FA;
}

/* Badge hotkey dans le gestionnaire (même style que #hotkeyBadge) */
QLabel#profileHotkeyBadge {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 6px;
    padding: 6px 10px;
    font-weight: 600;
    color: #F5F7FA;
}

/* ===== Mini Mode (vertical overlay) ===== */
#miniRoot {
    background: rgba(22,24,28,0.38);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 6px;
}

#miniHeader {
    background: transparent;
}

QPushButton#miniClose {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 12px;
    padding: 4px 6px;
}
QPushButton#miniClose:hover {
    background: rgba(255,255,255,0.14);
}

QLabel#miniDrag {
    color: rgba(255,255,255,0.75);
}

/* Carte d’un compte dans le mini */
QFrame#miniCard {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 12px;
}
QFrame#miniCard:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(0,229,255,0.35);
}
/* Tout ce qui est dedans n’a pas de fond par défaut */
QFrame#miniCard QLabel,
QFrame#miniCard QPushButton,
QFrame#miniCard QWidget { background: transparent; border: none; color: #F5F7FA; }

/* Badge index */
QLabel#miniIndex {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;
    padding: 2px 6px;
    color: rgba(255,255,255,0.85);
    font-size: 12px;
    min-width: 26px;
    qproperty-alignment: 'AlignCenter';
}

/* Badge hotkey */
QLabel#miniHotkey {
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
    min-width: 40px;
    qproperty-alignment: 'AlignCenter';
}

/* Switch (reprend le style principal) */
QCheckBox::indicator { width: 38px; height: 20px; }
QCheckBox::indicator:unchecked {
    border-radius: 10px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
                                stop:0 rgba(255,255,255,0.08),
                                stop:1 rgba(255,255,255,0.03));
    border: 1px solid rgba(255,255,255,0.18);
}
QCheckBox::indicator:checked {
    border-radius: 10px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
                                stop:0 rgba(0,208,132,0.85),
                                stop:1 rgba(0,229,255,0.85));
    border: 1px solid rgba(0,229,255,0.55);
}

/* Fix: pas de fond sous les éléments dans les cartes mini */
QFrame#miniCard QLabel,
QFrame#miniCard QPushButton,
QFrame#miniCard QWidget { background: transparent; border: none; }

/* Mini bar action button */
QPushButton#miniChange {
    background: rgba(0,229,255,0.14);
    border: 1px solid rgba(0,229,255,0.45);
    border-radius: 8px;
    color: #E6FBFF;
    padding: 4px 10px;
}
QPushButton#miniChange:hover {
    background: rgba(0,229,255,0.20);
    border-color: rgba(0,229,255,0.65);
}


/* ===== MINI MODE – compact (v2) ===== */

#miniRoot {
    background: rgba(22,24,28,0.72);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 18px;
    padding: 6px; /* ROOT_PAD doit matcher */
}

#miniDrag {
    font-size: 28px;
    line-height: 1;
    color: rgba(255,255,255,0.78);
    background: transparent;
    padding-left: 4px;
}
#miniDrag:hover { color: #FFFFFF; }

QFrame#miniCard {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 12px;
}
QFrame#miniCard:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(0,229,255,0.28);
}

QFrame#miniCard QLabel,
QFrame#miniCard QWidget,
QFrame#miniCard QPushButton {
    background: transparent;
    border: none;
    color: #F5F7FA;
}

QLabel#miniIndex {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 10px;
    padding: 1px 8px;
    color: rgba(255,255,255,0.86);
    font-size: 12px;
    min-width: 28px;
    qproperty-alignment: 'AlignCenter';
}

QCheckBox::indicator { width: 36px; height: 20px; }
QCheckBox::indicator:unchecked {
    border-radius: 10px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 rgba(255,255,255,0.10),
        stop:1 rgba(255,255,255,0.04));
    border: 1px solid rgba(255,255,255,0.18);
}
QCheckBox::indicator:checked {
    border-radius: 10px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,
        stop:0 rgba(0,208,132,0.90),
        stop:1 rgba(0,229,255,0.90));
    border: 1px solid rgba(0,229,255,0.55);
}

QPushButton#miniCloseBare {
    background: transparent;
    border: none;
    color: rgba(255,255,255,0.85);
    font-size: 20px;
    padding: 0;
}
QPushButton#miniCloseBare:hover { color: #FFFFFF; }

QLabel[muted="true"] { color: rgba(255,255,255,0.72); background: transparent; }
